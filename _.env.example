# Copy this file to .env and change the values.
# Generate a secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./school_bus.db

# Default admin, created on first start if it does not exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
